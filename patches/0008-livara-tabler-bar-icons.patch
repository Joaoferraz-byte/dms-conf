diff --git a/quickshell/Widgets/DankIcon.qml b/quickshell/Widgets/DankIcon.qml
--- a/quickshell/Widgets/DankIcon.qml
+++ b/quickshell/Widgets/DankIcon.qml
@@ -1,3 +1,205 @@
+// LIVARA_DMS_TABLER_ICONS: Replaces the upstream DankIcon (which renders
+// Material Symbols Rounded ligature glyphs via DankCommon.DankIcon) with a
+// Tabler-Icons-based renderer matching the Noctara-Dots / Noctalia v5
+// design language. The upstream `name` property uses Material Symbols
+// ligature names (e.g. "memory", "storage", "clear_day"); this component
+// keeps the same API surface so every existing call-site works unchanged,
+// but translates each Material Symbols name to the corresponding Tabler
+// Icons codepoint via an internal lookup table. Unmapped names fall back
+// to a help glyph so missing mappings are visually obvious.
+//
+// The Tabler Icons TTF is bundled by dms-conf and installed alongside the
+// DMS QML at assets/fonts/tabler-icons/tabler-icons.ttf. A FontLoader
+// resolves it at runtime; the font family is "tabler-icons".
+//
+// Variable-font axes (FILL, GRAD, opsz, wght) from the Material Symbols
+// renderer are accepted as no-op properties for API compatibility.
+import QtQuick
+import qs.DankCommon.Common
 import qs.DankCommon.Widgets as DankCommon
 
-DankCommon.DankIcon {}
+Item {
+    id: root
+
+    // --- Public API (compatible with DankCommon.DankIcon) ---
+    property string name: ""           // Material Symbols ligature name (kept for compatibility)
+    property alias size: icon.font.pixelSize
+    property alias color: icon.color
+    property bool filled: false        // accepted, ignored (Tabler is single-weight)
+    property real fill: filled ? 1.0 : 0.0  // accepted, ignored
+    property int grade: Style.isLightMode ? 0 : -25  // accepted, ignored
+    property int weight: filled ? 500 : 400  // accepted, ignored
+    property real weightAnim: weight
+    property bool smoothTransform: false
+
+    implicitWidth: Math.round(size)
+    implicitHeight: Math.round(size)
+
+    signal rotationCompleted
+
+    // --- Tabler Icons font ---
+    FontLoader {
+        id: tablerFont
+        source: Qt.resolvedUrl("../assets/fonts/tabler-icons/tabler-icons.ttf")
+    }
+
+    // --- Material Symbols name -> Tabler Icons codepoint map ---
+    readonly property var _tablerMap: ({
+        "add": "", // plus
+        "arrow_back": "", // arrow-left
+        "assignment": "", // clipboard-list
+        "auto_awesome_mosaic": "", // grid-dots
+        "battery_1_bar": "", // battery-1
+        "battery_2_bar": "", // battery-2
+        "battery_3_bar": "", // battery-2
+        "battery_4_bar": "", // battery-3
+        "battery_5_bar": "", // battery-3
+        "battery_6_bar": "", // battery-4
+        "battery_alert": "", // battery-1
+        "battery_charging_20": "", // battery-charging
+        "battery_charging_30": "", // battery-charging
+        "battery_charging_50": "", // battery-charging
+        "battery_charging_60": "", // battery-charging
+        "battery_charging_80": "", // battery-charging
+        "battery_charging_90": "", // battery-charging
+        "battery_charging_full": "", // battery-charging
+        "battery_full": "", // battery-4
+        "battery_std": "", // battery
+        "bluetooth": "", // bluetooth
+        "bluetooth_connected": "", // bluetooth-connected
+        "brightness_auto": "ﶙ", // brightness-auto
+        "brightness_high": "", // brightness-up
+        "brightness_low": "", // brightness-down
+        "brightness_medium": "", // brightness
+        "camera_video": "", // video
+        "check": "", // check
+        "chevron_right": "", // chevron-right
+        "clarify": "", // align-justified
+        "clear_day": "", // sun
+        "clear_night": "", // moon
+        "close": "", // x
+        "cloud": "", // cloud
+        "cloudy_snowing": "", // cloud-snow
+        "content_paste": "", // clipboard
+        "delete_sweep": "", // clear-all
+        "description": "", // file-text
+        "developer_board": "", // cpu
+        "device_thermostat": "", // temperature
+        "do_not_disturb_on": "", // bell-off
+        "expand_content": "", // arrows-maximize
+        "expand_more": "", // chevron-down
+        "foggy": "", // cloud-fog
+        "fullscreen": "", // arrows-maximize
+        "grid_on": "", // grid-dots
+        "grid_view": "", // layout-grid
+        "headset": "", // headphones
+        "hidden_horizontal": "", // arrows-horizontal
+        "hidden_vertical": "", // arrows-vertical
+        "keyboard": "", // keyboard
+        "lan": "", // plug
+        "layers": "", // stack
+        "lightbulb": "", // bulb
+        "logout": "", // door-exit
+        "memory": "", // cpu
+        "mic": "", // microphone
+        "mic_off": "", // microphone-off
+        "minimize": "", // minimize
+        "motion_sensor_active": "", // access-point
+        "motion_sensor_idle": "", // access-point-off
+        "music_note": "", // music
+        "network_check": "", // wifi
+        "notifications": "", // bell
+        "notifications_off": "", // bell-off
+        "palette": "", // palette
+        "partly_cloudy_day": "", // sun-low
+        "partly_cloudy_night": "", // moon-stars
+        "pause": "", // player-pause
+        "play_arrow": "", // player-play
+        "power": "", // power
+        "power_settings_new": "", // power
+        "print": "", // printer
+        "push_pin": "", // pin
+        "rainy": "", // cloud-rain
+        "rule": "", // scale
+        "screen_record": "", // video
+        "screen_share": "", // screen-share
+        "scrollable_header": "", // layout
+        "settings": "", // settings
+        "shift_lock": "", // arrow-back-up
+        "skip_next": "", // player-skip-forward
+        "skip_previous": "", // player-skip-back
+        "snowing_heavy": "", // snowflake
+        "speaker": "", // device-speaker
+        "sports_esports": "", // device-gamepad
+        "storage": "", // database
+        "sync": "", // refresh
+        "tablet_mac": "", // device-tablet
+        "terminal": "", // terminal-2
+        "thunderstorm": "", // cloud-bolt
+        "view_carousel": "", // carousel-horizontal
+        "view_compact": "", // layout-dashboard
+        "view_day": "", // layout-rows
+        "view_quilt": "", // layout-dashboard
+        "view_sidebar": "", // layout-sidebar
+        "visibility_off": "", // eye-off
+        "volume_down": "", // volume-2
+        "volume_mute": "", // volume-off
+        "volume_off": "", // volume-off
+        "volume_up": "", // volume
+        "vpn_key_off": "", // shield-off
+        "vpn_lock": "", // shield-lock
+        "warning": "", // alert-triangle
+        "wifi": "", // wifi
+        "wifi_1_bar": "", // wifi-1
+        "wifi_2_bar": "", // wifi-2
+        "wifi_3_bar": "", // wifi-2
+        "wifi_off": "", // wifi-off
+    })
+
+    // Fallback glyph (help icon) for unmapped names
+    readonly property string _fallback: ""
+
+    // Resolve the glyph: look up the mapping, pass through short strings,
+    // otherwise fall back to the help icon.
+    readonly property string _glyph: {
+        if (name.length === 0)
+            return "";
+        const code = root._tablerMap[name];
+        if (code !== undefined)
+            return code;
+        // Short strings (<=2 chars) are likely already literal glyphs/numbers
+        if (name.length <= 2)
+            return name;
+        return root._fallback;
+    }
+
+    // --- Renderer ---
+    DankCommon.StyledText {
+        id: icon
+
+        anchors.fill: parent
+
+        text: root._glyph
+        font.family: tablerFont.name || "tabler-icons"
+        font.pixelSize: Math.round(Style.fontSizeMedium)
+        font.weight: root.weight
+        font.hintingPreference: Font.PreferNoHinting
+        color: Style.surfaceText
+        verticalAlignment: Text.AlignVCenter
+        horizontalAlignment: Text.AlignHCenter
+        renderType: root.smoothTransform ? Text.QtRendering : Text.NativeRendering
+        textFormat: Text.PlainText
+    }
+
+    // Rotation support (used by some widgets for spin/sync animations)
+    Timer {
+        id: rotationTimer
+        interval: 16
+        repeat: false
+        onTriggered: root.rotationCompleted()
+    }
+
+    onRotationChanged: {
+        rotationTimer.restart();
+    }
+}
